NDjo","executionInfo":{"status":"ok","timestamp":1622961795307,"user_tz":-480,"elapsed":9,"user":{"displayName":"北科大-張嘉芸","photoUrl":"https://lh3.googleusercontent.com/a-/AOh14GhcM20C68MTH2x-G3yrqTq1HFjNhhYDEa_xSvay=s64","userId":"11213870514507527976"}}},"source":["import torch\n","from torch.autograd import Variable\n","import torch.nn.functional as F\n","import torch.utils.data as Data\n","\n","import matplotlib.pyplot as plt\n","%matplotlib inline\n","\n","import numpy as np\n","import imageio"],"execution_count":30,"outputs":[]},{"cell_type":"markdown","metadata":{"id":"4fHDcz3T33rh"},"source":["## Level 1"]},{"cell_type":"markdown","metadata":{"id":"TCQXmXYLHJHN"},"source":["建立資料集"]},{"cell_type":"code","metadata":{"id":"32ND4uosNDjp","colab":{"base_uri":"https://localhost:8080/","height":297},"executionInfo":{"status":"ok","timestamp":1622961796335,"user_tz":-480,"elapsed":1037,"user":{"displayName":"北科大-張嘉芸","photoUrl":"https://lh3.googleusercontent.com/a-/AOh14GhcM20C68MTH2x-G3yrqTq1HFjNhhYDEa_xSvay=s64","userId":"11213870514507527976"}},"outputId":"a820c2da-aad8-47e1-d313-227751e9de9a"},"source":["torch.manual_seed(1)    # reproducible\n","\n","x = torch.unsqueeze(torch.linspace(-1, 1, 100), dim=1)  # x data (tensor), shape=(100, 1)\n","y = x.pow(2) + 0.2*torch.rand(x.size())          # noisy y data (tensor), shape=(100, 1)\n","\n","# torch can only train on Variable, so convert them to Variable\n","x, y = Variable(x), Variable(y)\n","\n","# view data\n","plt.figure(figsize=(10,4))\n","plt.scatter(x.data.numpy(), y.data.numpy(), color = \"orange\")\n","plt.title('Regression Analysis')\n","plt.xlabel('Independent varible')\n","plt.ylabel('Dependent varible')\n","plt.tight_layout()\n","plt.savefig('/content/drive/My Drive/image/curve_0.png')\n","plt.show()"],"execution_count":31,"outputs":[{"output_type":"display_data","data":{"image/png":"\n","text/plain":["<Figure size 720x288 with 1 Axes>"]},"metadata":{"tags":[],"needs_background":"light"}}]},{"cell_type":"markdown","metadata":{"id":"sMQE8lKuHkRk"},"source":["建立神經網路"]},{"cell_type":"code","metadata":{"jupyter":{"outputs_hidden":true},"id":"nDaxUTO2NDjq","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1622961796336,"user_tz":-480,"elapsed":10,"user":{"displayName":"北科大-張嘉芸","photoUrl":"https://lh3.googleusercontent.com/a-/AOh14GhcM20C68MTH2x-G3yrqTq1HFjNhhYDEa_xSvay=s64","userId":"11213870514507527976"}},"outputId":"f6792352-177a-40ad-9caa-5921c1fa687f"},"source":["# this is one way to define a network\n","class Net(torch.nn.Module):\n","    def __init__(self, n_feature, n_hidden, n_output):\n","        super(Net, self).__init__()\n","        self.hidden = torch.nn.Linear(n_feature, n_hidden)   # hidden layer 隱藏層\n","        self.predict = torch.nn.Linear(n_hidden, n_output)   # output layer 輸出層\n","\n","    def forward(self, x):\n","        x = F.relu(self.hidden(x))      # activation function for hidden layer，x是資料\n","        x = self.predict(x)             # linear output\n","        return x\n","\n","net = Net(n_feature=1, n_hidden=10, n_output=1)     # define the network決定輸入維度，1維資料，進入10個神經單位元training，最後output 1個值\n","print(net)  # net architecture\n","#我們目標是逼近上面的那條線"],"execution_count":32,"outputs":[{"output_type":"stream","text":["Net(\n","  (hidden): Linear(in_features=1, out_features=10, bias=True)\n","  (predict): Linear(in_features=10, out_features=1, bias=True)\n",")\n"],"name":"stdout"}]},{"cell_type":"markdown","metadata":{"id":"3JI4fqJSHpVT"},"source":["訓練神經網路"]},{"cell_type":"code","metadata":{"id":"igWt7_6D-w_g","colab":{"base_uri":"https://localhost:8080/","height":1000},"executionInfo":{"status":"ok","timestamp":1622961824146,"user_tz":-480,"elapsed":27818,"user":{"displayName":"北科大-張嘉芸","photoUrl":"https://lh3.googleusercontent.com/a-/AOh14GhcM20C68MTH2x-G3yrqTq1HFjNhhYDEa_xSvay=s64","userId":"11213870514507527976"}},"outputId":"85aa7144-9ca0-4a1f-d486-4fba791a14fe"},"source":["optimizer = torch.optim.SGD(net.parameters(), lr=0.2)\n","loss_func = torch.nn.MSELoss()  # this is for regression mean squared loss\n","#我們用MSE當我們的LOSS Function\n","my_images = []\n","fig, ax = plt.subplots(figsize=(12,7))\n","\n","epochs = 200\n","# train the network\n","for epoch in range(epochs): \n","#pytorch可以自己定義的東西比較多，所以比較複雜，必須要自己寫要疊代幾次，不像karas只要 co model fit一下就結束了\n","  \n","    prediction = net(x)     # input x and predict based on x\n","\n","    loss = loss_func(prediction, y)    # must be (1. nn output, 2. target)loss function\n","\n","\n","    optimizer.zero_grad()   # clear gradients for next train\n","    loss.backward()         # backpropagation, compute gradients\n","    optimizer.step()        # apply gradients反向傳遞回去\n","    \n","    print(f'epoch:{epoch}, loss:{loss}')\n","\n","    # plot and show learning process把訓練的過程，做成動態圖顯示出來\n","    plt.cla()\n","    ax.set_title('Regression Analysis', fontsize=35)\n","    ax.set_xlabel('Independent variable', fontsize=24)\n","    ax.set_ylabel('Dependent variable', fontsize=24)\n","    ax.set_xlim(-1.05, 1.5)\n","    ax.set_ylim(-0.25, 1.25)\n","    ax.scatter(x.data.numpy(), y.data.numpy(), color = \"orange\")\n","    ax.plot(x.data.numpy(), prediction.data.numpy(), 'g-', lw=3)\n","    ax.text(1.0, 0.1, 'Step = %d' % epoch, fontdict={'size': 24, 'color':  'red'})\n","    ax.text(1.0, 0, 'Loss = %.4f' % loss.data.numpy(),\n","            fontdict={'size': 24, 'color':  'red'})\n","\n","    # Used to return the plot as an image array \n","    # (https://ndres.me/post/matplotlib-animated-gifs-easily/)\n","    fig.canvas.draw()       # draw the canvas, cache the renderer\n","    image = np.frombuffer(fig.canvas.tostring_rgb(), dtype='uint8')\n","    image = image.reshape(fig.canvas.get_width_height()[::-1] + (3,))\n","\n","    my_images.append(image)\n","    \n","\n","# save images as a gif    \n","imageio.mimsave(r'/content/drive/My Drive/image/curve_1.gif', my_images, fps=10)\n","\n","#pytorch的epoch和loss要自己定義，不像karas幫你寫好了\n","#loss慢慢下降代表有正確的收斂\n","#只有一個凹槽"],"execution_count":33,"outputs":[{"output_type":"stream","text":["epoch:0, loss:0.6628513932228088\n","epoch:1, loss:0.4381945729255676\n","epoch:2, loss:0.31177181005477905\n","epoch:3, loss:0.17632223665714264\n","epoch:4, loss:0.1271715760231018\n","epoch:5, loss:0.10064737498760223\n","epoch:6, loss:0.09066162258386612\n","epoch:7, loss:0.08569113910198212\n","epoch:8, loss:0.08304041624069214\n","epoch:9, loss:0.08118706941604614\n","epoch:10, loss:0.07966617494821548\n","epoch:11, loss:0.07827527821063995\n","epoch:12, loss:0.07693347334861755\n","epoch:13, loss:0.07561132311820984\n","epoch:14, loss:0.07430421561002731\n","epoch:15, loss:0.0730096623301506\n","epoch:16, loss:0.07171699404716492\n","epoch:17, loss:0.07042517513036728\n","epoch:18, loss:0.06913858652114868\n","epoch:19, loss:0.06786151975393295\n","epoch:20, loss:0.066584512591362\n","epoch:21, loss:0.06530740857124329\n","epoch:22, loss:0.064030721783638\n","epoch:23, loss:0.06276047974824905\n","epoch:24, loss:0.06149497628211975\n","epoch:25, loss:0.06022998318076134\n","epoch:26, loss:0.05896732211112976\n","epoch:27, loss:0.057710200548172\n","epoch:28, loss:0.05646291747689247\n","epoch:29, loss:0.05522812902927399\n","epoch:30, loss:0.0539974682033062\n","epoch:31, loss:0.052771665155887604\n","epoch:32, loss:0.051552511751651764\n","epoch:33, loss:0.05034466087818146\n","epoch:34, loss:0.04914407432079315\n","epoch:35, loss:0.047955483198165894\n","epoch:36, loss:0.04677920415997505\n","epoch:37, loss:0.04561265930533409\n","epoch:38, loss:0.04446101561188698\n","epoch:39, loss:0.04332707077264786\n","epoch:40, loss:0.0422058068215847\n","epoch:41, loss:0.04109811782836914\n","epoch:42, loss:0.04000488668680191\n","epoch:43, loss:0.038930196315050125\n","epoch:44, loss:0.03788205236196518\n","epoch:45, loss:0.03685354068875313\n","epoch:46, loss:0.035842202603816986\n","epoch:47, loss:0.034848686307668686\n","epoch:48, loss:0.033873654901981354\n","epoch:49, loss:0.