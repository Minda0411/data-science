 432x288 with 1 Axes>"]},"metadata":{"needs_background":"light"}},{"output_type":"stream","name":"stdout","text":["200\n","epoch:15, loss:0.3435591459274292\n"]}]},{"cell_type":"markdown","metadata":{"id":"vyCeVRCOAxeg"},"source":["# MNIST(手寫資料集)"]},{"cell_type":"code","metadata":{"id":"TBHM7BZhzwd2"},"source":["import torch\n","import torch.nn as nn\n","import torch.nn.functional as F\n","import torch.optim as optim\n","import torchvision\n","from torchvision import transforms, datasets\n","import numpy as np\n","import matplotlib.pyplot as plt"],"execution_count":null,"outputs":[]},{"cell_type":"code","metadata":{"id":"xahWmp2Rzwd4","colab":{"base_uri":"https://localhost:8080/","height":630},"executionInfo":{"status":"ok","timestamp":1631168748555,"user_tz":-480,"elapsed":32,"user":{"displayName":"北科大-張兆宜","photoUrl":"https://lh3.googleusercontent.com/a-/AOh14GhcM20C68MTH2x-G3yrqTq1HFjNhhYDEa_xSvay=s64","userId":"11213870514507527976"}},"outputId":"e29502c6-b62e-4a79-a18c-f9fa11ecfabb"},"source":["#trainset有6萬多張\n","trainset = datasets.MNIST('', train=True, download=True, \n","                       transform=transforms.Compose([\n","                                transforms.ToTensor()\n","                            ]))\n","\n","testset = datasets.MNIST('', train=False, download=True, \n","                       transform=transforms.Compose([\n","                                transforms.ToTensor()\n","                            ]))\n","\n","\n","trainloader  = torch.utils.data.DataLoader(trainset, batch_size=100, shuffle=True, pin_memory=True)\n","testloader  = torch.utils.data.DataLoader(testset, batch_size=100, shuffle=True, pin_memory=True)\n","\n","# show an image for example 我們copy一個shape的資料夾，把它疊代起來\n","X, y = iter(trainloader).next() # pick one batch\n","print(X.shape) # output-> torch.Size([100, 1, 28, 28]) 前兩個是Batch size=100, channel=1\n","X = torchvision.utils.make_grid(X) # make image to grid \n","plt.figure(figsize=(10, 10)) \n","plt.imshow(np.transpose(X, (1, 2, 0))) # show image, you need to transpose tensor to numpy array\n","#我們要做從0到9的分類，\n","#總共會download 6萬多筆資料夾"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["torch.Size([100, 1, 28, 28])\n"]},{"output_type":"execute_result","data":{"text/plain":["<matplotlib.image.AxesImage at 0x7f187406cbd0>"]},"metadata":{},"execution_count":15},{"output_type":"display_data","data":{"image/png":"\n","text/plain":["<Figure size 720x720 with 1 Axes>"]},"metadata":{"needs_background":"light"}}]},{"cell_type":"code","metadata":{"id":"73oBQRyDzwd6","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1631168770993,"user_tz":-480,"elapsed":22461,"user":{"displayName":"北科大-張兆宜","photoUrl":"https://lh3.googleusercontent.com/a-/AOh14GhcM20C68MTH2x-G3yrqTq1HFjNhhYDEa_xSvay=s64","userId":"11213870514507527976"}},"outputId":"c4ed5bf3-7458-4aca-d33b-671b22d543b5"},"source":["#定義一個神經網路\n","class Net(nn.Module):\n","    def __init__(self):\n","        super().__init__()\n","        # an affine operation: y = Wx + b\n","        self.fc1 = nn.Linear(28 * 28, 16)  # the image size is 28 by 28經過16個神經單位 ，你一定要改你的神經網路層\n","        self.fc2 = nn.Linear(16, 10)#16個單位10個class\n","        \n","    def forward(self, x):\n","        x = F.relu(self.fc1(x))\n","        x = self.fc2(x)\n","        \n","        return F.log_softmax(x, dim=1) #如果是softmax，我們可以決定資料是分到哪一類\n","      \n","net = Net() # inital network 我們把net copy回來\n","optimizer = optim.SGD(net.parameters(), lr=0.9)  # create a SGD optimizer可以變更優化函數\n","\n","net.train() #train和evalue一定要分開不然會有點不一樣\n","epochs = 5 #我們定義5個次數的epochs，最好增加準確率是調高epoch\n","for epoch in range(epochs):\n","    for data in trainloader:\n","        X, y = data\n","        # training process\n","        optimizer.zero_grad()    # clear the gradient calculated previously\n","        predicted = net(X.view(-1, 28 * 28))  # put the mini-batch training data to Nerual Network, and get the predicted labels\n","        loss = F.nll_loss(predicted, y)  # compare the predicted labels with ground-truth labels它會計算我們的loss\n","        loss.backward()      # compute the gradient它的population也要把它寫出來\n","        optimizer.step()     # optimize the network\n","    print(f'epoch:{epoch}, loss:{loss}')"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["epoch:0, loss:0.2544053792953491\n","epoch:1, loss:0.3578464388847351\n","epoch:2, loss:0.16087354719638824\n","epoch:3, loss:0.3906596004962921\n","epoch:4, loss:0.2628076672554016\n"]}]},{"cell_type":"code","metadata":{"id":"JdXiIpH8zwd6","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1631168775857,"user_tz":-480,"elapsed":4888,"user":{"displayName":"北科大-張兆宜","photoUrl":"https://lh3.googleusercontent.com/a-/AOh14GhcM20C68MTH2x-G3yrqTq1HFjNhhYDEa_xSvay=s64","userId":"11213870514507527976"}},"outputId":"42844f30-5d9f-4dad-a74e-b47011dba0e0"},"source":["\"\"\"\n","model.train()\" and \"model.eval()\" activates and deactivates Dropout and BatchNorm, so it is quite important. \n","\"with torch.no_grad()\" only deactivates gradient calculations, but doesn't turn off Dropout and BatchNorm.\n","Your model accuracy will therefore be lower if you don't use model.eval() when evaluating the model.\n","\"\"\"\n","#驗證\n","net.eval()#net.evalue會把剛剛兩個東西固定住，並且讓神經層數固定，讓它影響輸出概率影響結果\n","\n","correct = 0\n","total = 0\n","with torch.no_grad():#我不做遞迴的動作\n","    for data in trainloader:\n","        X, y = data\n","        output = net(X.view(-1, 28 * 28))\n","        correct += (torch.argmax(output, dim=1) == y).sum().item()\n","        total += y.size(0)\n","\n","print(f'Training data Accuracy: {correct}/{total} = {round(correct/total, 3)}')\n","\n","# Evaluation the testing data\n","correct = 0\n","total = 0\n","with torch.no_grad():\n","    for data in testloader:#把test資料load進來\n","        X, y = data\n","        output = net(X.view(-1, 28 * 28))\n","        correct += (torch.argmax(output, dim=1) == y).sum().item()\n","        total += y.size(0)\n","\n","print(f'testing data Accuracy: {correct}/{total} = {round(correct/total, 3)}')"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Training data Accuracy: 56615/60000 = 0.944\n","testing data Accuracy: 9374/10000 = 0.937\n"]}]},{"cell_type":"code","metadata":{"id":"9htdk6h03BhQ","executionInfo":{"status":"error","timestamp":1635056608449,"user_tz":-480,"elapsed":6,"user":{"displayName":"張兆宜","photoUrl":"https://lh3.googleusercontent.com/a-/AOh14GhcM20C68MTH2x-G3yrqTq1HFjNhhYDEa_xSvay=s64","userId":"11213870514507527976"}},"outputId":"4ed70d1a-a764-45d5-841a-edd026420611","colab":{"base_uri":"https://localhost:8080/","height":132}},"source":["import numpy as np \n","import pandas as pd \n","prediction = pd.DataFrame(target_predict,]).to_csv('gdrive/My Drive/北科大/python共同讀書會/我_predict.csv') "],"execution_count":1,"outputs":[{"output_type":"error","ename":"SyntaxError","evalue":"ignored","traceback":["\u001b[0;36m  File \u001b[0;32m\"<ipython-input-1-adbf82ea13f3>\"\u001b[0;36m, line \u001b[0;32m3\u001b[0m\n\u001b[0;31m    prediction = pd.DataFrame(target_predict,]).to_csv('gdrive/My Drive/北科大/python共同讀書會/我_predict.csv')\u001b[0m\n\u001b[0m                                             ^\u001b[0m\n\u001b[0;31mSyntaxError\u001b[0m\u001b[0;31m:\u001b[0m invalid syntax\n"]}]}]}