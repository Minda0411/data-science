riable, so convert them to Variable\n","x, y = Variable(x), Variable(y)\n","plt.figure(figsize=(10,4))\n","plt.scatter(x.data.numpy(), y.data.numpy(), color = \"blue\")\n","plt.title('Regression Analysis')\n","plt.xlabel('Independent varible')\n","plt.ylabel('Dependent varible')\n","plt.savefig('/content/drive/My Drive/image/curve_2.png')\n","plt.show()\n","\n","#有多個起伏"],"execution_count":3,"outputs":[{"output_type":"display_data","data":{"image/png":"\n","text/plain":["<Figure size 720x288 with 1 Axes>"]},"metadata":{"needs_background":"light"}}]},{"cell_type":"markdown","metadata":{"id":"GYpNcA1GtWaq"},"source":["## Level 3"]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"Z9bhCng7q8uI","executionInfo":{"status":"ok","timestamp":1631200459767,"user_tz":-480,"elapsed":43123,"user":{"displayName":"北科大-張兆宜","photoUrl":"https://lh3.googleusercontent.com/a-/AOh14GhcM20C68MTH2x-G3yrqTq1HFjNhhYDEa_xSvay=s64","userId":"11213870514507527976"}},"outputId":"c33f32ff-16b9-4d9c-c33f-1c0a324b7058"},"source":["# another way to define a network自己去疊疊看神經元\n","net = torch.nn.Sequential(\n","        torch.nn.Linear(1, 9500),\n","        torch.nn.LeakyReLU(),\n","        torch.nn.Linear(9500, 1),\n","    )\n","\n","optimizer = torch.optim.Adam(net.parameters(), lr=0.1) #也可以改優化函數和loss但效果不明顯\n","loss_func = torch.nn.MSELoss()  # this is for regression mean squared loss\n","\n","my_images = []\n","fig, ax = plt.subplots(figsize=(16,10))\n","\n","# start training\n","epochs = 500\n","for epoch in range(epochs):\n","  \n","    prediction = net(x)     # input x and predict based on x\n","\n","    loss = loss_func(prediction, y)     # must be (1. nn output, 2. target)\n","\n","    optimizer.zero_grad()   # clear gradients for next train\n","    loss.backward()         # backpropagation, compute gradients\n","    optimizer.step()        # apply gradients\n","    \n","    print(f'epoch:{epoch}, loss:{loss}')\n","\n","    if epoch % 10 == 0:\n","        # plot and show learning process\n","        plt.cla()\n","        ax.set_title('Regression Analysis - model 2', fontsize=35)\n","        ax.set_xlabel('Independent variable', fontsize=24)\n","        ax.set_ylabel('Dependent variable', fontsize=24)\n","        ax.set_xlim(-11.0, 13.0)\n","        ax.set_ylim(-1.1, 1.2)\n","        ax.scatter(x.data.numpy(), y.data.numpy(), color = \"blue\")\n","        ax.plot(x.data.numpy(), prediction.data.numpy(), 'g-', lw=3)\n","        ax.text(9.50, -0.8, 'Step = %d' % epoch, fontdict={'size': 18, 'color':  'red'})\n","        ax.text(9.50, -0.95, 'Loss = %.4f' % loss.data.numpy(),\n","                fontdict={'size': 18, 'color':  'red'})\n","\n","        # Used to return the plot as an image array \n","        # (https://ndres.me/post/matplotlib-animated-gifs-easily/)\n","        fig.canvas.draw()       # draw the canvas, cache the renderer\n","        image = np.frombuffer(fig.canvas.tostring_rgb(), dtype='uint8')\n","        image  = image.reshape(fig.canvas.get_width_height()[::-1] + (3,))\n","\n","        my_images.append(image)\n","    \n","    \n","\n","\n","# save images as a gif    \n","imageio.mimsave(r'/content/drive/My Drive/image/curve_2_張嘉芸作業.gif', my_images, fps=10)"],"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["epoch:0, loss:6.334740161895752\n","epoch:1, loss:1950579.125\n","epoch:2, loss:79268.0078125\n","epoch:3, loss:239175.75\n","epoch:4, loss:546255.1875\n","epoch:5, loss:396693.78125\n","epoch:6, loss:123124.0390625\n","epoch:7, loss:759.3413696289062\n","epoch:8, loss:89487.2421875\n","epoch:9, loss:216913.15625\n","epoch:10, loss:220183.609375\n","epoch:11, loss:137704.171875\n","epoch:12, loss:53244.44921875\n","epoch:13, loss:7598.85302734375\n","epoch:14, loss:2054.326904296875\n","epoch:15, loss:19568.513671875\n","epoch:16, loss:36946.9765625\n","epoch:17, loss:39870.7890625\n","epoch:18, loss:29146.421875\n","epoch:19, loss:13737.7626953125\n","epoc