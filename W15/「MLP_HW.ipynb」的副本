get the predicted labels\n","        loss = F.nll_loss(predicted, y)  # compare the predicted labels with ground-truth labels它會計算我們的loss\n","        loss.backward()      # compute the gradient它的population也要把它寫出來\n","        optimizer.step()     # optimize the network\n","    print(f'epoch:{epoch}, loss:{loss}')"],"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["epoch:0, loss:0.19139741361141205\n","epoch:1, loss:0.03231717646121979\n","epoch:2, loss:0.07903141528367996\n","epoch:3, loss:0.04345817118883133\n","epoch:4, loss:0.013272244483232498\n","epoch:5, loss:0.008491849526762962\n","epoch:6, loss:0.011261630803346634\n","epoch:7, loss:0.02099578082561493\n","epoch:8, loss:0.01072151679545641\n","epoch:9, loss:0.016039088368415833\n","epoch:10, loss:0.05237475037574768\n","epoch:11, loss:0.05028097704052925\n","epoch:12, loss:0.0019408066291362047\n","epoch:13, loss:0.003825437743216753\n","epoch:14, loss:0.009097517468035221\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Y_47pVkl8ICO","executionInfo":{"status":"ok","timestamp":1631200560748,"user_tz":-480,"elapsed":6427,"user":{"displayName":"北科大-張兆宜","photoUrl":"https://lh3.googleusercontent.com/a-/AOh14GhcM20C68MTH2x-G3yrqTq1HFjNhhYDEa_xSvay=s64","userId":"11213870514507527976"}},"outputId":"d20c98f8-a9d4-48a6-8470-0587fac4c2de"},"source":["\"\"\"\n","model.train()\" and \"model.eval()\" activates and deactivates Dropout and BatchNorm, so it is quite important. \n","\"with torch.no_grad()\" only deactivates gradient calculations, but doesn't turn off Dropout and BatchNorm.\n","Your model accuracy will therefore be lower if you don't use model.eval() when evaluating the model.\n","\"\"\"\n","#驗證\n","net.eval()#net.evalue會把剛剛兩個東西固定住，並且讓神經層數固定，讓它影響輸出概率影響結果\n","\n","correct = 0\n","total = 0\n","with torch.no_grad():#我不做遞迴的動作\n","    for data in trainloader:\n","        X, y = data\n","        output = net(X.view(-1, 28 * 28))\n","        correct += (torch.argmax(output, dim=1) == y).sum().item()\n","        total += y.size(0)\n","\n","print(f'Training data Accuracy: {correct}/{total} = {round(correct/total, 3)}')\n","\n","# Evaluation the testing data\n","correct = 0\n","total = 0\n","with torch.no_grad():\n","    for data in testloader:#把test資料load進來\n","        X, y = data\n","        output = net(X.view(-1, 28 * 28))\n","        correct += (torch.argmax(output, dim=1) == y).sum().item()\n","        total += y.size(0)\n","\n","print(f'testing data Accuracy: {correct}/{total} = {round(correct/total, 3)}')"],"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["Training data Accuracy: 59942/60000 = 0.999\n","testing data Accuracy: 9799/10000 = 0.98\n"]}]},{"cell_type":"code","metadata":{"id":"yCOjdz7GJF1w"},"source":[""],"execution_count":null,"outputs":[]}]}