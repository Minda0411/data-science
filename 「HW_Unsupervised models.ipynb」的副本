googleusercontent.com/a-/AOh14GhcM20C68MTH2x-G3yrqTq1HFjNhhYDEa_xSvay=s64","userId":"11213870514507527976"}},"outputId":"1505905b-094e-40eb-b306-3a2dd3548a7a"},"source":["#KNN\n","#What:一種監督學習的演算法，是所有受監督的機器學習算法中最簡單的算法之一。\n","#How :它僅計算新數據點到所有其他訓練數據點的距離。該距離可以是任何類型，例如歐幾里得或曼哈頓等。然後，它選擇K個最近數據點，其中K可以是任何整數。最後，它將數據點分配給大多數K個數據點所屬的類。\n","#KNN算法不適用於高維數據，因為維數眾多，該算法很難計算每個維中的距離。\n","#對於大型數據集，KNN算法具有很高的預測成本 need give k、距離函數 計算每个點之间的距离成本變得更高\n","\n","from sklearn.neighbors import KNeighborsClassifier\n","n_neighbors=2\n","knn = KNeighborsClassifier(n_neighbors=n_neighbors)\n","knn.fit(x,y)\n","pred_y = knn.predict(x)\n","print('knn_score',knn.score(x, y))\n","\n","true_pred = pd.concat([y,pd.DataFrame(pred_y,columns=['pred'])],axis=1) #被分錯的\n","error_class = true_pred[true_pred.iloc[:,0]-true_pred.iloc[:,1]>0].index.tolist() #被分錯index\n","pred_y[error_class]=n_neighbors \n","\n","plt.scatter(x=x.iloc[:,0], y= x.iloc[:,1],c=pred_y, cmap='coolwarm')"],"execution_count":258,"outputs":[{"output_type":"stream","text":["knn_score 0.8866666666666667\n"],"name":"stdout"},{"output_type":"stream","text":["/usr/local/lib/python3.7/dist-packages/ipykernel_launcher.py:10: DataConversionWarning: A column-vector y was passed when a 1d array was expected. Please change the shape of y to (n_samples, ), for example using ravel().\n","  # Remove the CWD from sys.path while we load stuff.\n"],"name":"stderr"},{"output_type":"execute_result","data":{"text/plain":["<matplotlib.collections.PathCollection at 0x7fb903a63850>"]},"metadata":{"tags":[]},"execution_count":258},{"output_type":"display_data","data":{"image/png":"\n","text/plain":["<Figure size 432x288 with 1 Axes>"]},"metadata":{"tags":[]}}]}]}