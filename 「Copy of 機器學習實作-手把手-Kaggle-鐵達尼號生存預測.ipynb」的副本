e, bins=45, color='skyblue', label='bins = 45' )\n","plt.xlabel( 'Log Fare' ) \n","plt.ylabel( '' ) \n","plt.legend( )\n","\n","plt.show()"],"execution_count":255,"outputs":[{"output_type":"display_data","data":{"image/png":"\n","text/plain":["<Figure size 864x360 with 2 Axes>"]},"metadata":{"tags":[]}}]},{"cell_type":"code","metadata":{"id":"JsvYWSxZpITn","colab":{"base_uri":"https://localhost:8080/","height":337},"executionInfo":{"status":"ok","timestamp":1621324248052,"user_tz":-480,"elapsed":105868,"user":{"displayName":"北科大-張嘉芸","photoUrl":"https://lh3.googleusercontent.com/a-/AOh14GhcM20C68MTH2x-G3yrqTq1HFjNhhYDEa_xSvay=s64","userId":"11213870514507527976"}},"outputId":"10985f16-22c4-44ca-ce4b-f1f693083efb"},"source":["# 盒鬚圖(Box Plot)\n","fig, axs = plt.subplots( 1,2,figsize=(12,5) )\n","\n","plt.subplot( 1,2,1 )\n","sns.boxplot( df_data.Fare, orient='h', color='skyblue' )\n","plt.xlabel( 'Fare' ) \n","\n","plt.subplot( 1,2,2 )\n","sns.boxplot( df_data.LogFare, orient='h', color='skyblue' )\n","plt.xlabel( 'Log Fare' ) \n","\n","plt.show()"],"execution_count":256,"outputs":[{"output_type":"display_data","data":{"image/png":"\n","text/plain":["<Figure size 864x360 with 2 Axes>"]},"metadata":{"tags":[]}}]},{"cell_type":"markdown","metadata":{"id":"9bk8HhdEpITp"},"source":["從上面直方圖及盒鬚圖可知，初步判斷 Fare 欄位可能存有離群值( i.e., 大於 Q3+1.5$\\times$IQR )。計算 Fare 欄位的四分位數(Quartile)，且以四分位數對 Fare 欄位進行分組，觀察生存率是否會因票價組別的高低有所差異？藉此判斷票價大於 Q3+1.5$\\times$IQR 是否可視為離群值。"]},{"cell_type":"code","metadata":{"id":"1rKlf2YEpITp","colab":{"base_uri":"https://localhost:8080/","height":297},"executionInfo":{"status":"ok","timestamp":1621324248054,"user_tz":-480,"elapsed":105854,"user":{"displayName":"北科大-張嘉芸","photoUrl":"https://lh3.googleusercontent.com/a-/AOh14GhcM20C68MTH2x-G3yrqTq1HFjNhhYDEa_xSvay=s64","userId":"11213870514507527976"}},"outputId":"c1f9145e-f3b6-4477-8583-daab22c411f7"},"source":["# 計算 Fare 欄位各個百分位數(Percentile)\n","P_all = [ np.percentile( df_data.Fare, q=i ) for i in np.arange(0,101) ] \n","Pth_Percentile = pd.DataFrame( { 'Q':list(range(101)), 'Value':P_all } )\n","\n","# The first、second and third quartile(i,e., the 25th、50th and 75th Percentile)\n","Q1 = Pth_Percentile.iloc[ 25, 1 ]\n","Q2 = Pth_Percentile.iloc[ 50, 1 ]\n","Q3 = Pth_Percentile.iloc[ 75, 1 ]\n","IQR = Q3 - Q1\n","\n","print( f'Q1 = {Q1}' )\n","print( f'Q2 = {Q2} = Median' )\n","print( f'Q3 = {Q3}' )\n","print( f'Maximum = {df_data.Fare.max()}')\n","print( f'IQR = Q3 - Q1 = {IQR}' )\n","print( f'Q3 + 1.5IQR = {Q3+1.5*IQR}' )\n","\n","# 依照四分位數，對 Fare 欄位進行分組\n","Fare_bin = [ 0, Q1, Q2, Q3, Q3+1.5*IQR, df_data.Fare.max() ]\n","df_data[ 'Fare_Group' ] = pd.cut( df_data.Fare.values, Fare_bin )\n","\n","# 計算每個分組中的資料筆數\n","Group_Counts = df_data[ 'Fare_Group' ].value_counts().reset_index()    \n","Group_Counts.columns = [ 'Fare_Group', 'Counts' ]\n","Group_Counts.sort_values( by='Fare_Group' )"],"execution_count":257,"outputs":[{"output_type":"stream","text":["Q1 = 7.8958\n","Q2 = 14.4 = Median\n","Q3 = 30.6958\n","Maximum = 512.3292\n","IQR = Q3 - Q1 = 22.799999999999997\n","Q3 + 1.5IQR = 64.8958\n"],"name":"stdout"},{"output_type":"execute_result","data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>Fare_Group</th>\n","      <th>Counts</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>2</th>\n","      <td>(0.0, 7.896]</td>\n","      <td>257</td>\n","    </tr>\n","    <tr>\n","      <th>1</th>\n","      <td>(7.896, 14.4]</td>\n","      <td>266</td>\n","    </tr>\n","    <tr>\n","      <th>0</th>\n","      <td>(14.4, 30.696]</td>\n","      <td>270</td>\n","    </tr>\n","  